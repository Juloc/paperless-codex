PAPERLESS_URL=http://webserver:8000
PAPERLESS_TOKEN=replace-with-paperless-api-token
BRIDGE_KEY=replace-with-a-long-random-secret

# Scanner identity / provenance
PAPERLESS_CODEX_VERSION=0.1.7
PAPERLESS_CODEX_PIPELINE_VERSION=9

# Store technical AI metadata in one Paperless custom field instead of tags.
PROVENANCE_TAGS=false
PROVENANCE_CUSTOM_FIELD=true
PROVENANCE_FIELD_NAME=AI Provenienz

# Tags are stable semantic labels, up to six total.
# Existing tags are always preferred. At most two genuinely new, reusable topic tags
# may be created per document when no existing tag is a good match.
# Dates, amounts, IDs, company names and other structured values belong in fields instead.
MAX_SEMANTIC_TAGS=6
MAX_NEW_SEMANTIC_TAGS=2

# Re-read documents after a scan and verify that Paperless actually persisted writes.
VERIFY_PAPERLESS_WRITES=true

# Discover new Paperless documents automatically; no Paperless webhook is required.
AUTO_DISCOVERY=true
DISCOVERY_INTERVAL_MS=60000
DISCOVERY_PAGE_SIZE=200

# When Codex reports usage/rate/quota exhaustion, keep the document queued and retry later.
USAGE_LIMIT_RETRY_MS=1800000

# Direct document scanning
MAX_DOCUMENT_BYTES=52428800
MAX_PAGES=20
PDF_DPI=150
CODEX_TIMEOUT_MS=360000
MIN_CONFIDENCE=0.55

# Automatic metadata is only written above this confidence.
# Between MIN_CONFIDENCE and this threshold, OCR may still improve but metadata is marked review in AI Provenienz.
AUTO_APPLY_CONFIDENCE=0.80

# Retry ordinary transient Codex/Paperless failures twice after the initial attempt.
MAX_RETRIES=2
RETRY_DELAY_MS=15000

# OCR write-back. A plausible Codex OCR above the confidence threshold replaces Paperless OCR.
# If the PDF scan was truncated by MAX_PAGES, existing Paperless OCR is kept to avoid losing unscanned pages.
OCR_MIN_CONFIDENCE=0.70
OCR_REPLACE_MODE=validated

# Empty = Codex account default/automatic model.
# Set explicitly for exact provenance when supported by your Codex account.
CODEX_MODEL=

# Paperless write-back
WRITE_CONTENT=true
CREATE_MISSING_METADATA=true

# Prefer existing Paperless metadata over creating near-duplicates.
EXISTING_MATCH_THRESHOLD=0.86

# Existing custom fields are discovered automatically. Filled fields are protected by default.
OVERWRITE_CUSTOM_FIELDS=false
