PAPERLESS_URL=http://webserver:8000
PAPERLESS_TOKEN=replace-with-paperless-api-token
BRIDGE_KEY=replace-with-a-long-random-secret

# Scanner identity / provenance
PAPERLESS_CODEX_VERSION=0.3.0
PAPERLESS_CODEX_PIPELINE_VERSION=23

# Store technical AI metadata in one Paperless custom field instead of tags.
PROVENANCE_TAGS=false
PROVENANCE_CUSTOM_FIELD=true
PROVENANCE_FIELD_NAME=AI Provenienz

# Result compatibility is separate from app/pipeline versions.
# Keep this unchanged so the Smart-Scan rollout does not re-scan the entire existing archive.
RESULT_COMPATIBILITY_VERSION=9

# Smart scan: one isolated Codex context per document.
# Luna handles normal high-volume work; Sol is used only once when Luna fails or is below confidence.
SMART_PRIMARY_MODEL=gpt-5.6-luna
SMART_STRONG_MODEL=gpt-5.6-sol
SMART_ESCALATE_CONFIDENCE=0.68

# Digital PDFs are read locally from the ORIGINAL PDF with pdftotext.
# Only selected evidence is sent to the model; no automatic OCR write-back happens.
SMART_TEXT_MIN_CHARS=300
SMART_TEXT_MAX_CHARS=24000

# Image/scanned PDFs: only a few representative pages go to Luna automatically.
SMART_VISION_PAGES=3
SMART_VISION_DPI=110

# Manual full OCR action scans the complete document up to this limit.
FULL_SCAN_MAX_PAGES=50
FULL_SCAN_DPI=150
ANALYSIS_CACHE_VERSION=smart-v1

# Tags are stable semantic labels, up to six total.
# Existing tags are always preferred. At most two genuinely new, reusable topic tags
# may be created per document when no existing tag is a good match.
# Dates, amounts, IDs, company names and other structured values belong in fields instead.
MAX_SEMANTIC_TAGS=6
MAX_NEW_SEMANTIC_TAGS=2

# Small pause between completed scans to keep Paperless responsive during large queues/bulk runs.
QUEUE_INTER_SCAN_DELAY_MS=3000

# Re-read documents after a scan and verify that Paperless actually persisted writes.
VERIFY_PAPERLESS_WRITES=true

# Discover new Paperless documents automatically; no Paperless webhook is required.
AUTO_DISCOVERY=true
DISCOVERY_INTERVAL_MS=60000
DISCOVERY_PAGE_SIZE=200

# When Codex reports usage/rate/quota exhaustion, keep the document queued and retry later.
USAGE_LIMIT_RETRY_MS=1800000

# Document limits / timeout
MAX_DOCUMENT_BYTES=52428800
MAX_PAGES=20
PDF_DPI=150
CODEX_TIMEOUT_MS=360000
MIN_CONFIDENCE=0.55

# Automatic metadata is only written above this confidence.
AUTO_APPLY_CONFIDENCE=0.80

# Retry ordinary transient Codex/Paperless failures twice after the initial attempt.
# Smart-scan AI results are cached by original-file SHA so a Paperless write retry does not pay for AI again.
MAX_RETRIES=2
RETRY_DELAY_MS=15000

# OCR write-back is used only by the explicit manual full-scan action.
OCR_MIN_CONFIDENCE=0.70
OCR_REPLACE_MODE=validated

# Optional model for chat/legacy paths. Smart scanner uses SMART_PRIMARY_MODEL/SMART_STRONG_MODEL above.
CODEX_MODEL=

# Paperless write-back. Smart scans preserve existing content; full scan may replace it when validated.
WRITE_CONTENT=true
CREATE_MISSING_METADATA=true

# Prefer existing Paperless metadata over creating near-duplicates.
EXISTING_MATCH_THRESHOLD=0.86

# Existing custom fields are discovered automatically. Filled fields are protected by default.
OVERWRITE_CUSTOM_FIELDS=false

# Assistant / Paperless native AI gateway
# Paperless can point its openai-like backend at http://paperless-codex:8080/openai/v1
# using BRIDGE_KEY as the Bearer API key. The gateway uses the same logged-in Codex account.

# Pause without failing a document when Paperless returns transient 5xx/network errors.
PAPERLESS_TRANSIENT_RETRY_MS=60000
