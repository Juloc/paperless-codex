PAPERLESS_URL=http://webserver:8000
PAPERLESS_TOKEN=replace-with-paperless-api-token
BRIDGE_KEY=replace-with-a-long-random-secret

# Scanner identity / provenance
PAPERLESS_CODEX_VERSION=0.1.1
PAPERLESS_CODEX_PIPELINE_VERSION=3
PROVENANCE_TAGS=true

# Direct document scanning
MAX_DOCUMENT_BYTES=52428800
MAX_PAGES=20
PDF_DPI=150
CODEX_TIMEOUT_MS=360000
MIN_CONFIDENCE=0.55

# Automatic metadata is only written above this confidence.
# Between MIN_CONFIDENCE and this threshold, OCR may still improve but metadata is tagged AI Status: Review.
AUTO_APPLY_CONFIDENCE=0.80

# Retry transient Codex/Paperless failures twice after the initial attempt.
MAX_RETRIES=2
RETRY_DELAY_MS=15000

# OCR improvement. "better" only replaces Paperless content when Codex OCR passes
# confidence/plausibility checks and is at least comparable to the existing OCR.
OCR_MIN_CONFIDENCE=0.70
OCR_REPLACE_MODE=better

# Empty = Codex account default/automatic model.
# If Codex reports the resolved model in JSON events, paperless-codex records it.
# For guaranteed exact model provenance, set CODEX_MODEL explicitly.
CODEX_MODEL=

# Paperless write-back
WRITE_CONTENT=true
CREATE_MISSING_METADATA=true

# Prefer existing Paperless metadata over creating near-duplicates.
EXISTING_MATCH_THRESHOLD=0.86

# Existing custom fields are discovered automatically. Filled fields are protected by default.
OVERWRITE_CUSTOM_FIELDS=false
